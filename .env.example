# All connections are optional while reviewing the website.
# Set these in Vercel > Project > Settings > Environment Variables.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_MEETING_BOOKING_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only HTTPS receiver. Accepts multipart/form-data, including resume.
# A 2xx response must mean the application was actually accepted.
JOIN_FORM_ENDPOINT=
# Optional Bearer token; never exposed to the browser.
JOIN_FORM_TOKEN=

# Optional separate resume receiver; see README for its response contract.
# If absent, the resume is sent directly to JOIN_FORM_ENDPOINT.
RESUME_UPLOAD_HANDLER=

# Show neutral media placeholders during development/review.
# Set false for public deployment to hide slots without real assets.
NEXT_PUBLIC_SHOW_ASSET_PLACEHOLDERS=true
